[Desktop Entry]
Type=Application
# Not booster-launched, so the setgid privileged group applies (contacts)
X-Nemo-Application-Type=no-invoker
Icon=phonehook
Exec=phonehook
Name=Hookline
# translation example:
# your app name in German locale (de)
Name[de]=Hookline


# The GUI shares ~/.phonehook and D-Bus with the daemon and reads contacts
[X-Sailjail]
Sandboxing=Disabled
